---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';
import { publications } from '../data/publications';

import '../styles/about.css';
import '../styles/publications.css';
---

<Layout pageTitle="Research" description="Research interests, current projects, publications, and presentations by Amrin Kharawala, MD.">
    <div class="page-container">
        <h1>Research</h1>

        <div class="info-card">
            <p>My work spans preventive cardiology, cardiovascular imaging, women's cardiovascular health, pulmonary vascular disease, health equity, and evidence synthesis.</p>
            <div class="research-profile-links">
                <a href={`https://scholar.google.com/citations?user=${SITE_DATA.scholar}`} class="info-card-link" target="_blank" rel="noopener noreferrer" aria-label="Visit Google Scholar profile">
                    <svg viewBox="0 0 24 24" width="60" height="60" fill="currentColor" aria-hidden="true">
                        <path d="M12 2L1 7l11 5 9-4.09V17h2V7L12 2z"></path>
                        <path d="M19 11v6c0 1.66-3.13 3-7 3s-7-1.34-7-3v-6l7 3 7-3z"></path>
                    </svg>
                    <span>Google Scholar</span>
                </a>
                <a href="https://pubmed.ncbi.nlm.nih.gov/?term=Kharawala+A&cauthor_id=35893223" class="info-card-link" target="_blank" rel="noopener noreferrer" aria-label="View publications on PubMed">
                    <svg viewBox="0 0 24 24" width="60" height="60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
                        <path d="M9 7h6M9 11h6"></path>
                    </svg>
                    <span>PubMed</span>
                </a>
            </div>
        </div>

        <section>
            <h2>Current projects</h2>
            <ul class="custom-list">
                <li><span class="list-item-title">Exercise-induced pulmonary hypertension</span><span class="list-item-description">Comparative effectiveness of riociguat and sildenafil in a single-center retrospective study.</span></li>
                <li><span class="list-item-title">Atrial fibrillation and myocardial infarction</span><span class="list-item-description">Systematic review and meta-analysis comparing paroxysmal and non-paroxysmal atrial fibrillation.</span></li>
                <li><span class="list-item-title">Extra-coronary calcification and cognition</span><span class="list-item-description">Analysis of cognitive measures in the Multi-Ethnic Study of Atherosclerosis.</span></li>
                <li><span class="list-item-title">Cardiovascular risk prediction in women</span><span class="list-item-description">Collaborative manuscript work through the American Society of Preventive Cardiology.</span></li>
                <li><span class="list-item-title">Women in cardiovascular clinical trials</span><span class="list-item-description">Work examining how under-representation affects cardiovascular disease prevention and treatment.</span></li>
            </ul>
        </section>

        <section class="publications-section">
            <h2>Peer-reviewed publications</h2>
            <p class="results-info">All {publications.length} full-text peer-reviewed journal publications listed in the current <a href={`${import.meta.env.BASE_URL}cv/`}>CV</a> are included below.</p>
            <div class="publications-list">
                {publications.map((publication, index) => (
                    <article class="publication-card visible">
                        <div class="pub-number">{index + 1}</div>
                        <div class="pub-content">
                            <h3 class="pub-title"><a href={publication[5] ? `https://pubmed.ncbi.nlm.nih.gov/${publication[5]}/` : `https://doi.org/${publication[4]}`} target="_blank" rel="noopener noreferrer">{publication[0]}</a></h3>
                            <p class="pub-authors">{publication[1]}</p>
                            <div class="pub-meta">
                                <span class="pub-journal">{publication[2]}</span>
                                <span class="pub-year">{publication[3]}</span>
                                {publication[5] && <a href={`https://pubmed.ncbi.nlm.nih.gov/${publication[5]}/`} class="pub-doi" target="_blank" rel="noopener noreferrer">PubMed</a>}
                                <a href={`https://doi.org/${publication[4]}`} class="pub-doi" target="_blank" rel="noopener noreferrer">DOI</a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section>
            <h2>Selected presentations and scholarly writing</h2>
            <ul class="custom-list">
                <li><span class="list-item-title">Delivery planning in a high-risk patient with peripartum cardiomyopathy</span><span class="list-item-description">Oral presentation, American College of Cardiology Nebraska Chapter, 2025.</span></li>
                <li><span class="list-item-title">Efficacy of cardioprotective drugs in patients receiving anthracyclines</span><span class="list-item-description">Oral presentation and best systematic review and meta-analysis award, American College of Cardiology Nebraska Chapter, 2024.</span></li>
                <li><span class="list-item-title">Comparative effectiveness of riociguat versus sildenafil in exercise-induced pulmonary hypertension</span><span class="list-item-description">Poster presentation, American College of Cardiology Scientific Session, 2026.</span></li>
                <li><span class="list-item-title">Inverse association of extra-coronary calcification with cognitive measures</span><span class="list-item-description">Poster presentation, American College of Cardiology Scientific Session, 2025.</span></li>
                <li><span class="list-item-title">Stepping out of the clinic and onto the Hill</span><span class="list-item-description">American College of Cardiology Cardiology Magazine, December 2025.</span></li>
            </ul>
        </section>
    </div>
</Layout>
