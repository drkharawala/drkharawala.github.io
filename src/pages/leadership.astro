---
import Layout from '../layouts/Layout.astro';

import '../styles/about.css';
---

<Layout pageTitle="Leadership" description="Leadership, mentorship, peer review, awards, and service by Amrin Kharawala, MD.">
    <div class="page-container">
        <h1>Leadership and service</h1>

        <section>
            <h2>Cardiology leadership</h2>
            <ul class="work-list icon-list">
                <li>
                    <div class="list-entry">
                        <h3>Fellow-in-Training Representative</h3>
                        <p class="institution">American College of Cardiology, Nebraska Chapter</p>
                        <p>Serving as course director for the inaugural Nebraska Cardiology Fellows Bootcamp and contributing as an abstract reviewer for chapter and national programs.</p>
                    </div>
                </li>
                <li>
                    <div class="list-entry">
                        <h3>Women's Cardiovascular Health Contributor</h3>
                        <p class="institution">University of Nebraska Medical Center</p>
                        <p>Contributing to the development of the Women's Cardiovascular Clinic and its clinical protocols.</p>
                    </div>
                </li>
                <li>
                    <div class="list-entry">
                        <h3>Working Group Member and Mentorship Program Lead</h3>
                        <p class="institution">American Society of Preventive Cardiology</p>
                        <p>Co-developing the pilot mentorship program and participating in the Women in Cardiology, Women's Cardiovascular Health, FIT and Early Career, SAPNA, Nutrition, and AJPC Academy groups.</p>
                    </div>
                </li>
                <li>
                    <div class="list-entry">
                        <h3>Fellow Mentor</h3>
                        <p class="institution">American College of Cardiology</p>
                        <p>Mentoring participants in the Internal Medicine and Pediatrics Cardiology Program and serving in the Young Scholars program in 2025 and 2026.</p>
                    </div>
                </li>
                <li>
                    <div class="list-entry">
                        <h3>President, Wellness Committee</h3>
                        <p class="institution">Jacobi Medical Center and Albert Einstein College of Medicine</p>
                        <p>Led resident wellness work and served as a resident representative to Graduate Medical Education from 2022 through 2024.</p>
                    </div>
                </li>
            </ul>
        </section>

        <section>
            <h2>Editorial and peer review</h2>
            <ul class="custom-list">
                <li><span class="list-item-title">JACC: Advances</span><span class="list-item-description">Peer reviewer, 2026 - present</span></li>
                <li><span class="list-item-title">American Journal of Preventive Cardiology</span><span class="list-item-description">Peer reviewer, 2025 - present</span></li>
                <li><span class="list-item-title">Frontiers in Cardiovascular Medicine</span><span class="list-item-description">Peer reviewer, 2025 - present</span></li>
                <li><span class="list-item-title">BMC Cardiovascular Disorders and BMC Pulmonary Medicine</span><span class="list-item-description">Peer reviewer, 2024 - present</span></li>
                <li><span class="list-item-title">Journal of Clinical Medicine, BMJ Open, BMJ Case Reports, European Journal of Medical Case Reports, and Cureus</span><span class="list-item-description">Peer-review service across clinical medicine and cardiovascular research.</span></li>
            </ul>
        </section>

        <section>
            <h2>Awards and distinctions</h2>
            <ul class="distinctions-list icon-list">
                <li><span class="list-item-title">Best Fellow Research Award</span><span class="list-item-description">University of Nebraska Medical Center, 2025-2026 academic year.</span></li>
                <li><span class="list-item-title">Cardiovascular Disease Prevention Training Academy</span><span class="list-item-description">Selected participant, American Society of Preventive Cardiology, 2026.</span></li>
                <li><span class="list-item-title">Fuster Prevention Forum</span><span class="list-item-description">Selected participant in the inaugural American College of Cardiology program, 2026.</span></li>
                <li><span class="list-item-title">Best Systematic Review and Meta-analysis</span><span class="list-item-description">American College of Cardiology Nebraska Chapter, 2024.</span></li>
                <li><span class="list-item-title">Best Original Research and Best Original Writing</span><span class="list-item-description">13th Annual Milford Fulop Poster Competition, 2023.</span></li>
            </ul>
        </section>

        <section>
            <h2>Community service</h2>
            <ul class="custom-list">
                <li><span class="list-item-title">Women's health outreach</span><span class="list-item-description">Fellow volunteer in Omaha, 2025.</span></li>
                <li><span class="list-item-title">COVID-19 public health support</span><span class="list-item-description">Contact tracing specialist through Larkin Medical Center, 2020-2021.</span></li>
                <li><span class="list-item-title">World Health Organization campaigns</span><span class="list-item-description">Polio immunization, measles-rubella monitoring, and Mission Indradhanush field work in India, 2018.</span></li>
            </ul>
        </section>
    </div>
</Layout>
